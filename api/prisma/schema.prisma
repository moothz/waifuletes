generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  WHATSAPP
  TELEGRAM
  DISCORD
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

enum KakeraReason {
  DAILY_REWARD
  DIVORCE
  ROLL_CRYSTAL
  ADMIN_GRANT
  EVENT_REWARD
  WISHLIST_BONUS
  SOULMATE_BONUS
  MARKET_TRADE
}

model User {
  id          String       @id
  publicId    String       @unique @default(dbgenerated("gen_random_uuid()"))
  name        String
  platform    Platform     @default(WHATSAPP)
  kakera      Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  groups        UserGroup[]
  harem         HaremEntry[]
  soulmates     Soulmate[]
  wishlist      WishlistEntry[]
  kakeraHistory KakeraTransaction[]
  suggestions   CharacterSuggestion[]
  marketListings MarketListing[]
  buyerOffers    MarketOffer[]         @relation("BuyerOffers")
  sellerOffers   MarketOffer[]         @relation("SellerOffers")
  covetsGiven    CharacterCovet[]      @relation("UserCovets")
  covetsReceived CharacterCovet[]      @relation("OwnerCovets")
  marketNotifications MarketListingNotification[]

  @@index([kakera(sort: Desc)])
  @@map("users")
}

model Group {
  id          String       @id
  name        String
  platform    Platform     @default(WHATSAPP)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members        UserGroup[]
  admins         GroupAdmin[]
  disabledSeries GroupDisabledSeries[]

  @@map("groups")
}

model UserGroup {
  userId    String
  groupId   String
  joinedAt  DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("user_groups")
}

model GroupAdmin {
  userId    String
  groupId   String
  grantedAt DateTime   @default(now())

  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("group_admins")
}

model Character {
  id          String       @id
  name        String
  series      String
  description String?
  baseRarity  Rarity       @default(COMMON)
  rank        Int?
  gender      Gender       @default(FEMALE)
  tags        String[]     @default([])
  imageUrls   String[]     @default([])
  claimCount  Int          @default(0)
  likeCount   Int          @default(0)
  isActive    Boolean      @default(true)
  addedAt     DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  haremEntries   HaremEntry[]
  soulmates      Soulmate[]
  wishlists      WishlistEntry[]
  disabledGroups GroupDisabledSeries[]
  suggestions    CharacterSuggestion[]
  marketListings MarketListing[]
  covets         CharacterCovet[]
  marketNotifications MarketListingNotification[]

  @@index([claimCount(sort: Desc), likeCount(sort: Desc)])
  @@index([baseRarity, claimCount(sort: Desc)])
  @@map("characters")
}

model HaremEntry {
  id             String    @id @default(cuid())
  userId         String
  characterId    String
  claimedAt      DateTime  @default(now())
  claimedInGroup String
  keys           Int       @default(1)
  isFavorite     Boolean   @default(false)
  note           String?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId])
  @@unique([userId, characterId])
  @@index([userId])
  @@map("harem_entries")
}

model Soulmate {
  id               String    @id @default(cuid())
  userId           String
  characterId      String
  becameSoulmateAt DateTime  @default(now())
  alias            String?
  note             String?

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character        Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@map("soulmates")
}

model WishlistEntry {
  id          String    @id @default(cuid())
  userId      String
  characterId String
  isStarWish  Boolean   @default(false)
  addedAt     DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@index([userId])
  @@index([characterId])
  @@map("wishlist_entries")
}

model KakeraTransaction {
  id        String       @id @default(cuid())
  userId    String
  amount    Int
  reason    KakeraReason
  metadata  Json?
  createdAt DateTime     @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("kakera_transactions")
}

model GroupDisabledSeries {
  groupId     String
  characterId String

  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([groupId, characterId])
  @@map("group_disabled_series")
}

enum SuggestionType {
  RARITY
  IMAGE
  NEW_CHARACTER
  DELETE_CHARACTER
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model CharacterSuggestion {
  id              String           @id @default(cuid())
  characterId     String?
  userId          String?
  type            SuggestionType
  status          SuggestionStatus @default(PENDING)
  characterName   String?
  series          String?
  description     String?
  currentRarity   Rarity?
  suggestedRarity Rarity?
  reason          String?
  imageUrl        String?
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  character       Character?       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([characterId])
  @@index([userId])
  @@map("character_suggestions")
}

enum ListingStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model MarketListing {
  id             String         @id @default(cuid())
  userId         String
  characterId    String
  interest       String         // O que o vendedor busca (texto livre)
  status         ListingStatus  @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  character      Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  offers         MarketOffer[]
  notifications  MarketListingNotification[]

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([characterId])
  @@map("market_listings")
}

model MarketOffer {
  id                  String         @id @default(cuid())
  listingId           String
  buyerId             String
  sellerId            String
  message             String?
  offeredItems        Json           // { waifuIds: string[], fishes: object[], fishingBuffs: object[], farmItems: object[], isFree: boolean }
  status              OfferStatus    @default(PENDING)
  cancelReason        String?        // Motivo caso cancelada (ex: falta de itens)
  notifiedSeller      Boolean        @default(false)
  notifiedBuyer       Boolean        @default(false)
  buyerNotifiedStatus String?        // "ACCEPTED" | "REJECTED" | "CANCELLED"
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  listing             MarketListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer               User           @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  seller              User           @relation("SellerOffers", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([buyerId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@map("market_offers")
}

enum CovetStatus {
  PENDING
  SEEN
  IGNORED
}

model CharacterCovet {
  id            String      @id @default(cuid())
  characterId   String      @map("character_id")
  userId        String      @map("user_id")
  ownerId       String      @map("owner_id")
  status        CovetStatus @default(PENDING)
  notifiedOwner Boolean     @default(false) @map("notified_owner")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  character     Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user          User        @relation("UserCovets", fields: [userId], references: [id], onDelete: Cascade)
  owner         User        @relation("OwnerCovets", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([characterId, userId])
  @@index([ownerId, status])
  @@index([ownerId, notifiedOwner])
  @@index([characterId])
  @@map("character_covets")
}

model MarketListingNotification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  listingId   String   @map("listing_id")
  characterId String   @map("character_id")
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing     MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([userId, notified])
  @@map("market_listing_notifications")
}


