{
  "name": "waifuletes-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Waifuletes - API REST do clone do Mudae para bots",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && prisma generate",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx src/jobs/importManifest.ts",
    "test": "vitest run",
    "bench": "tsx scripts/bench.ts",
    "forward:suggestions": "tsx scripts/forwardPendingSuggestionsToTelegram.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/otel": "0.21.4",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.223.2",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.2",
    "@opentelemetry/instrumentation": "0.223.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-ioredis": "0.71.0",
    "@opentelemetry/instrumentation-pino": "0.69.0",
    "@opentelemetry/instrumentation-runtime-node": "0.36.1",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@opentelemetry/sdk-node": "0.223.2",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@prisma/client": "^5.19.1",
    "dotenv": "^18.0.9",
    "fastify": "^4.28.1",
    "fastify-plugin": "^6.0.1",
    "google-translate-api-x": "^10.7.3",
    "ioredis": "^6.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prisma": "^5.19.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vitest": "^5.1.0"
  }
}
