# ==============================================================================
# Waifuletes — Configurações de Ambiente (.env.example)
#
# Dica: Execute './scripts/gen-env.sh' para gerar um arquivo .env pronto com
# chaves criptograficamente seguras automaticamente!
# ==============================================================================

# Servidor Fastify
PORT=3030
HOST=0.0.0.0
NODE_ENV=production

# Autenticação (Suporta múltiplas chaves separadas por vírgula)
API_KEYS=your_secure_hex_key_at_least_32_chars_long_here
ADMIN_PASSWORD=your_secure_admin_password_here
CORS_ORIGINS=*
ENABLE_SWAGGER=false

# Banco de Dados PostgreSQL
POSTGRES_USER=waifu_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=waifuletes_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://waifu_user:your_secure_postgres_password_here@postgres:5432/waifuletes_db?schema=public&connection_limit=10&pool_timeout=10

# Cache e Filas Redis
REDIS_PORT=6380
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379/0

# Economia e Moeda
CURRENCY_NAME=Kakera
CURRENCY_EMOJI=💎
DAILY_KAKERA_AMOUNT=300
DAILY_KAKERA_VARIANCE=150

# Cooldowns (em segundos)
COOLDOWN_ROLL_SECONDS=300        # 5 minutos para recarregar 1 roll
COOLDOWN_CLAIM_SECONDS=7200      # 2 horas
COOLDOWN_DAILY_SECONDS=72000     # Legado / fallback
DAILY_RESET_HOUR_UTC=7           # Reset diário fixo às 07:00 UTC (04:00 BRT / Horário de Brasília)
DAILY_RESET_MINUTE_UTC=0
CLAIM_LOCK_SECONDS=300           # Janela de claim após roll (5 minutos)
ROLL_MAX_BASE=9                  # Limite base máximo de rolls
ROLL_REGEN_SECONDS=300           # Tempo base de regeneração de 1 roll em segundos (5 minutos)
ROLL_REGEN_ACCEL_FACTOR=20       # Fator de aceleração por roll extra (dividido por 1000: 20 = 0.020)
ROLL_LEGENDARY_CHANCE_CAP=80     # Cap máximo de chance para Lendários (0 a 10000 | 80 = 0.80% | 10000 = 10%)

# Progressão
SOULMATE_KEYS_REQUIRED=10
WISHLIST_MAX_ITEMS=1000

# Armazenamento e URLs
CHARACTERS_DIR=./media/characters
INTERNAL_BASE_URL=http://localhost:3030
PUBLIC_BASE_URL=http://localhost:3030

# ==============================================================================
# Taxa de Hospedagem & Inatividade (Ativo + Inativo)
# ==============================================================================
# Percentual de abatimento do divórcio integral ao confiscar waifus por dívida.
# Representado em permille (por mil): 3000 = 30.00%
HOSTING_CONFISCO_PERMILLE=3000

# Taxa diária por waifu para jogadores INATIVOS (> HOSTING_GRACE_HOURS sem jogar)
# Formato CSV na ordem: COMMON,UNCOMMON,RARE,EPIC,LEGENDARY
HOSTING_TAXAS_INATIVAS=10,60,200,350,1000

# Taxa diária por waifu para jogadores ATIVOS (cobrada diariamente de todos)
# Formato CSV na ordem: COMMON,UNCOMMON,RARE,EPIC,LEGENDARY
HOSTING_TAXAS_ATIVAS=1,3,8,15,40

# Período de tolerância antes de aplicar taxa de inatividade (em horas)
HOSTING_GRACE_HOURS=72

# ==============================================================================
# Configurações de Hub e Satélite (Catálogo & Storage Remoto)
# ==============================================================================
# [Modo Hub / Servidor Central]
# Chaves autorizadas para bots e satélites externos consumirem o acervo e mídias
# (Suporta múltiplas chaves separadas por vírgula)
EXTERNAL_USAGE_API=your_external_api_key_1_here,your_external_api_key_2_here

# [Modo Satélite / Consumidor Remoto (Zero-Import & Zero-Disk Media)]
# Se você estiver rodando uma instância cliente conectada a um Hub Waifuletes:
# O sistema puxa o pool para RAM e faz streaming de fotos sem precisar baixar 34GB de mídia!
# UPSTREAM_API_URL=https://waifuletes.upstream.example
# UPSTREAM_API_KEY=your_upstream_token_here
# REMOTE_MEDIA_BASE_URL=https://waifuletes.upstream.example/api/v1/external/media


# [Integração com a Ravena (bot) e Jardim das Sombras]
# RAVENA_API_URL=http://172.22.0.1:5001
# JARDIM_API_URL=http://172.22.0.1:3040
# Segredo compartilhado das rotas internas de mercado da Ravena (/api/market/transfer e /user-inventory).
# Use o MESMO valor em MARKET_API_SECRET no .env da Ravena (mínimo 16 caracteres, ex.: openssl rand -hex 32).
MARKET_API_SECRET=your_shared_market_secret_here

# [IA do Conselheiro de Raridade]
# HYPERION_LLM_URL=http://seu-servidor-llm:16001/v1
# HYPERION_LLM_KEY=your_llm_api_key_here
# HYPERION_LLM_MODEL=gemma4:12b-uncensored
