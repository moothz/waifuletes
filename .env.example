# ==============================================================================
# Waifuletes — Configurações de Ambiente (.env.example)
#
# Dica: Execute './scripts/gen-env.sh' para gerar um arquivo .env pronto com
# chaves criptograficamente seguras automaticamente!
# ==============================================================================

# Servidor Fastify
PORT=3030
HOST=0.0.0.0
NODE_ENV=production

# Autenticação (Suporta múltiplas chaves separadas por vírgula)
API_KEYS=your_secure_hex_key_at_least_32_chars_long_here
ADMIN_PASSWORD=your_secure_admin_password_here
CORS_ORIGINS=*
ENABLE_SWAGGER=false

# Banco de Dados PostgreSQL
POSTGRES_USER=waifu_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=waifuletes_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://waifu_user:your_secure_postgres_password_here@postgres:5432/waifuletes_db?schema=public&connection_limit=10&pool_timeout=10

# Cache e Filas Redis
REDIS_PORT=6380
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379/0

# Economia e Moeda
CURRENCY_NAME=Zinthos
CURRENCY_EMOJI=💜
DAILY_KAKERA_AMOUNT=300
DAILY_KAKERA_VARIANCE=150
COOLDOWN_DAILY_SECONDS=72000

# Cooldowns (em segundos)
COOLDOWN_ROLL_SECONDS=600        # 10 minutos para recarregar 1 roll
COOLDOWN_CLAIM_SECONDS=7200      # 2 horas (fallback legado)
COOLDOWN_CLAIM_SECONDS_COMMON=1800       # 30 minutos para personagens Comuns
COOLDOWN_CLAIM_SECONDS_UNCOMMON=2700     # 45 minutos para personagens Incomuns
COOLDOWN_CLAIM_SECONDS_RARE=3600         # 60 minutos (1 hora) para personagens Raros
COOLDOWN_CLAIM_SECONDS_EPIC=5400         # 90 minutos (1h30m) para personagens Épicos
COOLDOWN_CLAIM_SECONDS_LEGENDARY=21600   # 360 minutos (6 horas) para personagens Lendários
DAILY_RESET_HOUR_UTC=7           # Reset diário fixo às 07:00 UTC (04:00 BRT / Horário de Brasília)
DAILY_RESET_MINUTE_UTC=0
CLAIM_LOCK_SECONDS=300           # Janela de claim após roll (5 minutos)

# Sistema de Rolls, Regeneração e Teto de Lendárias
ROLL_MAX_BASE=9                  # Limite base máximo de rolls
ROLL_REGEN_SECONDS=300           # Tempo base de regeneração de 1 roll em segundos (5 minutos)
ROLL_REGEN_ACCEL_FACTOR=7        # Fator de aceleração por roll extra (dividido por 1000: 7 = 0.007)
ROLL_LEGENDARY_CHANCE_CAP=80     # Cap máximo de chance para Lendários (0 a 10000 | 80 = 0.80% | 10000 = 10%)
WEEKLY_LEGENDARY_HARD_CAP=8      # Teto semanal de Lendárias obtidas por jogador no roll (bloqueio total após 8)
ROLL_SCRAP_BONUS_FACTOR=0.3      # Fator de bônus por rolls disponíveis (~15% do valor base)
ROLL_SCRAP_BONUS_CAP=150         # Teto máximo do bônus de rolls disponíveis
ROLL_RANK_MAX_DIFFICULTY=7.0     # Dificuldade máxima de rolagem ponderada por rank/popularidade
ROLL_RANK_REF_CUTOFF=20000       # Ponto de corte de rank do catálogo para cálculo de dificuldade

# Progressão
SOULMATE_KEYS_REQUIRED=10
SOULMATE_RANKING_SCORE=2100
WISHLIST_MAX_ITEMS=1000

# Cotas de Mercado, Soulmate e Economia
COTA_BASE_DAILY_ZINTHOS=21000
COTA_RARITY_DAYS=20,29,40,60,25
COTA_DAYS_COMMON=20        # Comum: 20 dias (420.000 Zinthos por 4 cotas | 105.000 Zinthos por cota)
COTA_DAYS_UNCOMMON=29      # Incomum: 29 dias (609.000 Zinthos por 4 cotas | 152.250 Zinthos por cota) [~55% OFF]
COTA_DAYS_RARE=40          # Raro: 40 dias (840.000 Zinthos por 4 cotas | 210.000 Zinthos por cota)
COTA_DAYS_EPIC=60          # Épico: 60 dias (1.260.000 Zinthos por 4 cotas | 315.000 Zinthos por cota)
COTA_DAYS_LEGENDARY=25     # Lendário: 25 dias (525.000 Zinthos por 4 cotas | 131.250 Zinthos por cota)
COTA_MARRIED_PROGRESSION_WEIGHTS=0.35,0.40,0.50,0.55,0.65,0.75,0.85,0.95,1.00
COTA_INFLATION_ALPHA=0.05
COTA_SCARCITY_BETAS=0.5,0.5,0.6,0.7,0.7
RANK_MULTIPLIER_MAX=5
DIVORCE_PAYOUT_MULTIPLIER=2.0

# Armazenamento e URLs
CHARACTERS_DIR=./media/characters
INTERNAL_BASE_URL=http://localhost:3030
PUBLIC_BASE_URL=http://localhost:3030

# ==============================================================================
# Taxa de Hospedagem & Inatividade (Ativo + Inativo)
# ==============================================================================
# Percentual de abatimento do divórcio integral ao confiscar waifus por dívida.
# Representado em permille (por mil): 3000 = 30.00%
HOSTING_CONFISCO_PERMILLE=3000

# Taxa diária por waifu para jogadores INATIVOS (> HOSTING_GRACE_HOURS sem jogar)
# Formato CSV na ordem: COMMON,UNCOMMON,RARE,EPIC,LEGENDARY
HOSTING_TAXAS_INATIVAS=100,320,700,1200,3000

# Taxa diária por waifu para jogadores ATIVOS (cobrada diariamente de todos)
# Formato CSV na ordem: COMMON,UNCOMMON,RARE,EPIC,LEGENDARY
HOSTING_TAXAS_ATIVAS=1,3,8,15,40

# Período de tolerância antes de aplicar taxa de inatividade (em horas)
HOSTING_GRACE_HOURS=72

# Acréscimo percentual diário sobre a taxa de inatividade por dia adicional offline (15 = 15%/dia)
HOSTING_INACTIVE_DAILY_SURCHARGE_PERCENT=15

# Multiplicador máximo sobre a taxa base de inatividade
HOSTING_INACTIVE_MAX_MULTIPLIER=7

# ==============================================================================
# Configurações de Hub e Satélite (Catálogo & Storage Remoto)
# ==============================================================================
# [Modo Hub / Servidor Central]
# Chaves autorizadas para bots e satélites externos consumirem o acervo e mídias
# (Suporta múltiplas chaves separadas por vírgula)
EXTERNAL_USAGE_API=your_external_api_key_1_here,your_external_api_key_2_here

# [Modo Satélite / Consumidor Remoto (Zero-Import & Zero-Disk Media)]
# Se você estiver rodando uma instância cliente conectada a um Hub Waifuletes:
# O sistema puxa o pool para RAM e faz streaming de fotos sem precisar baixar 34GB de mídia!
# UPSTREAM_API_URL=https://waifuletes.upstream.example
# UPSTREAM_API_KEY=your_upstream_token_here
# REMOTE_MEDIA_BASE_URL=https://waifuletes.upstream.example/api/v1/external/media


# [Integração com a Ravena (bot) e Jardim das Sombras]
# RAVENA_API_URL=http://172.22.0.1:5001
# JARDIM_API_URL=http://172.22.0.1:3040
# Segredo compartilhado das rotas internas de mercado da Ravena (/api/market/transfer e /user-inventory).
# Use o MESMO valor em MARKET_API_SECRET no .env da Ravena (mínimo 16 caracteres, ex.: openssl rand -hex 32).
MARKET_API_SECRET=your_shared_market_secret_here

# [IA do Conselheiro de Raridade]
# HYPERION_LLM_URL=http://seu-servidor-llm:16001/v1
# HYPERION_LLM_KEY=your_llm_api_key_here
# HYPERION_LLM_MODEL=gemma4:12b-uncensored

# [Telegram Bot & Moderação de Sugestões / Denúncias]
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=-1001234567890
# Segredo opcional para autenticação do webhook do Telegram (1-256 chars [A-Za-z0-9_-]).
# Se omitido, é derivado deterministicamente via HMAC-SHA256 a partir do TELEGRAM_BOT_TOKEN.
# TELEGRAM_WEBHOOK_SECRET=your_custom_webhook_secret_here
# Permite requisições no webhook sem validação de cabeçalho (apenas para transição temporária):
# TELEGRAM_WEBHOOK_ALLOW_UNSIGNED=false

# [Observabilidade — OpenTelemetry] (opcional; ver OBSERVABILITY.md)
# Sem OTEL_EXPORTER_OTLP_ENDPOINT a telemetria fica DESLIGADA (nenhum pacote do SDK é carregado).
# O backend (collector + Jaeger + Prometheus + Grafana) fica em ravena-ai/observability.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# OTEL_SERVICE_NAME=waifuletes
# Desliga tudo mesmo com o endpoint definido:
# OTEL_SDK_DISABLED=true
# Nível do log interno do SDK (error | warn | info | debug):
# OTEL_LOG_LEVEL=error
